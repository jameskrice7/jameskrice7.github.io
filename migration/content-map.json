[
  {
    "source": "_publications/Beyond_post_truth_climate_misinformation.md",
    "url": "/publications/Beyond_post_truth_climate_misinformation/",
    "meta": {
      "title": "Beyond post-truth: Projecting the future trajectory of climate misinformation",
      "collection": "publications",
      "layout": "single",
      "author": "James Kennon Rice",
      "category": "manuscripts",
      "excerpt": "Climate misinformation represents one of the most significant barriers to effective climate action in the 21st century. Building upon Yotam Ophir’s framework, this essay examines how climate misinformation is evolving and projects its future trajectory.",
      "date": "2026-05-04",
      "volume": 5,
      "issue": 5,
      "pages": "e0000916",
      "venue": "PLOS Climate",
      "paperurl": "https://journals.plos.org/climate/article?id=10.1371/journal.pclm.0000916",
      "citation": "Rice, James. (2026) \"Beyond post-truth: Projecting the future trajectory of climate misinformation.\" <i>PLOS Climate</i> 5(5): e0000916."
    },
    "body_sha256": "44c860514d6420ca39c9fbe7c8c248adc736f633ac2897b7253426d2ffe60297"
  },
  {
    "source": "_publications/epistemic_frontier_capitalism.md",
    "url": "/publications/epistemic_frontier_capitalism/",
    "meta": {
      "title": "The Epistemic Frontier of Capitalism: A Theory of Epistemic Regression through Artificial Intelligence and Misinformation",
      "collection": "publications",
      "layout": "single",
      "author": "James Rice",
      "category": "manuscripts",
      "excerpt": "This article argues that contemporary capitalism has entered a phase in which outcomes are increasingly shaped by the privatization and strategic destabilization of the epistemic commons through frontier artificial intelligence and platform-mediated misinformation.",
      "date": "2026-07-17",
      "volume": 1,
      "issue": 3,
      "pages": "177-187",
      "venue": "Cambridge Journal of Artificial Intelligence",
      "paperurl": "https://cjai.co.uk/wp-content/uploads/2026/07/The-Epistemic-Frontier-of-Capitalism_-A-Theory-of-Epistemic-Regression-through-Artificial-Intelligence-and-Misinformation.pdf",
      "citation": "Rice, James. (2026). \"The Epistemic Frontier of Capitalism: A Theory of Epistemic Regression through Artificial Intelligence and Misinformation.\" <i>Cambridge Journal of Artificial Intelligence</i>, 1(3), 177-187."
    },
    "body_sha256": "8bd679b8370069d7f467511fc207b58e363f07506a25a23aa4438d2539a1bd03"
  },
  {
    "source": "_publications/Just_emissions.md",
    "url": "/publications/Just_emissions/",
    "meta": {
      "title": "The Prospect of Just Emissions as an International Norm of Environmental Governance",
      "collection": "publications",
      "layout": "single",
      "author": "James Kennon Rice",
      "category": "manuscripts",
      "excerpt": "So-called luxury emissions of Global North countries need to be curtailed in line with, and also more rapidly than, the increase in emissions from Global South nations. I argue there is a growing need for radical social austerity and climate conservatism on the part of large emitters.",
      "date": "2024-11-01",
      "volume": 1,
      "issue": 2,
      "pages": "194-203",
      "venue": "Cambridge Journal of Climate Research",
      "paperurl": "https://diamond-oa.lib.cam.ac.uk/entities/publication/dd4dd96a-c2c6-4592-81ff-5076140977e8",
      "citation": "Rice, James. (2024). &quot;The Prospect of Just Emissions as an International Norm of Environmental Governance.&quot; <i>Cambridge Journal of Climate Research</i>, 1(2), 194-203."
    },
    "body_sha256": "662703545be8b55dc1fef0091283472e549dc7b61b26074c9be9d370ec7da0d5"
  },
  {
    "source": "_publications/Knowledge_asymmetries_climate_finance.md",
    "url": "/publications/Knowledge_asymmetries_climate_finance/",
    "meta": {
      "title": "Knowledge Asymmetries and Climate Finance: An Inquiry into Environmental Market Failures and Political Legitimacy",
      "collection": "publications",
      "layout": "single",
      "author": "James Kennon Rice",
      "category": "manuscripts",
      "excerpt": "In archetypal credit and capital markets, informational gaps can lead to the withdrawal of high-impact participants and incentivise excessive risk-taking by parties unaware of the risks they face. Within climate-related markets there is a similar trend: investors systematically underestimate tail risks associated with carbon-intensive assets—including risks from climate-caused natural events, which threaten those assets—while firms strategically under-disclose their exposure to these physical and transition risks.",
      "date": "2025-12-31",
      "volume": 2,
      "issue": 2,
      "pages": "117-135",
      "venue": "Cambridge Journal of Climate Research",
      "paperurl": "https://diamond-oa.lib.cam.ac.uk/entities/publication/01f6e952-af8f-4eda-bbf6-cd1b2d2cfbf8",
      "citation": "Rice, James. (2025). \"Knowledge Asymmetries and Climate Finance: An Inquiry into Environmental Market Failures and Political Legitimacy.\" <i>Cambridge Journal of Climate Research</i>, 2(2), 117-135."
    },
    "body_sha256": "662703545be8b55dc1fef0091283472e549dc7b61b26074c9be9d370ec7da0d5"
  },
  {
    "source": "_publications/liberal_order_complex_societies_climate_change.md",
    "url": "/publications/liberal_order_complex_societies_climate_change/",
    "meta": {
      "title": "The liberal order in complex societies marred by climate change",
      "collection": "publications",
      "layout": "single",
      "author": "James Rice",
      "category": "manuscripts",
      "excerpt": "This essay develops a complexity-oriented research program for classical liberal thought, showing how rule-of-law institutions can enable cooperation amid political, economic, and environmental pressures from climate change.",
      "date": "2026-05-29",
      "volume": 7,
      "pages": "Article 16",
      "venue": "Review of Evolutionary Political Economy",
      "paperurl": "https://link.springer.com/article/10.1007/s43253-026-00184-6",
      "citation": "Rice, James. (2026). \"The liberal order in complex societies marred by climate change.\" <i>Review of Evolutionary Political Economy</i>, 7, Article 16. https://doi.org/10.1007/s43253-026-00184-6"
    },
    "body_sha256": "5748ec59347d1f8368fbb3adec5a2272dd24ad5fabd212bcc5ff0d9d0cee30c8"
  },
  {
    "source": "_publications/misinformation_challenge_information_freedom.md",
    "url": "/publications/misinformation_challenge_information_freedom/",
    "meta": {
      "title": "The Misinformation Challenge: How Information Freedom Promotes Democratic Discourse",
      "collection": "publications",
      "layout": "single",
      "author": "James Kennon Rice",
      "category": "manuscripts",
      "excerpt": "The contemporary discourse surrounding misinformation has generated unprecedented calls for government intervention in information markets and content regulation. This article argues that decentralized information governance, market competition, and robust protections for free expression offer a stronger democratic response than top-down content controls.",
      "date": "2026-02-05",
      "volume": 29,
      "issue": 2,
      "pages": "176-208",
      "venue": "Journal of Libertarian Studies",
      "paperurl": "https://jls.mises.org/article/155344-the-misinformation-challenge-how-information-freedom-promotes-democratic-discourse",
      "citation": "Rice, James. (2026). \"The Misinformation Challenge: How Information Freedom Promotes Democratic Discourse.\" <i>Journal of Libertarian Studies</i>, 29(2), 176-208."
    },
    "body_sha256": "2e582ee1b7f366b8cbc39b8c8fec6ed7ba379b9d0c7cc0a5088b806a92d95bf1"
  },
  {
    "source": "_working_papers/Climate_Misinformation.md",
    "url": "/working_papers/Climate_Misinformation/",
    "meta": {
      "title": "Climate Change Misinformation and Integrity in Environmental Communication",
      "author": "James Kennon Rice",
      "collection": "working_papers",
      "category": "working_papers",
      "excerpt": "While our beliefs about crucial political issues such as climate change are shaped by a variety of psychological and socioeconomic influences, this essay argues that one source of those beliefs comes from the responsibility that climate scientists have, as domain experts on the science and policy of climate change, to protect the public from misinformation.",
      "date": "2024-11-01",
      "venue": "Working Paper",
      "citation": "Rice, James Kennon. (2024). &quot;The Social Justification of Climate Change Beliefs and Environmental Commuinication.&quot; <i>Working Paper</i>."
    },
    "body_sha256": "5279d73d07b6769ef78254e136d4e9a2f04c68b57a2a41434e5d4ec28d74d329"
  },
  {
    "source": "_working_papers/climate_misinformation_esg.md",
    "url": "/working_papers/climate_misinformation_esg/",
    "meta": {
      "title": "Does Climate Misinformation Affect ESG Performance? Evidence from Social Media and Firm-Level Data",
      "collection": "working_papers",
      "author": "James Kennon Rice",
      "category": "working_papers",
      "excerpt": "This paper combines social media analytics with corporate performance data to test how misinformation surrounding climate change influences firms' ESG outcomes.",
      "date": "2025-02-01",
      "venue": "Under Review at <i>Ecological Economics</i>",
      "citation": "Rice, James Kennon. (2025). \"Does Climate Misinformation Affect ESG Performance? Evidence from Social Media and Firm-Level Data.\" <i>Under Review at Ecological Economics</i>."
    },
    "body_sha256": "22705aa96da15dab207f70defd29d888a6da676305b8baeadbbad84296a2e52b"
  },
  {
    "source": "_working_papers/ecological_ethics.md",
    "url": "/working_papers/ecological_ethics/",
    "meta": {
      "title": "An Ecological Ethics for the Anthropocene: Environmental Justice and Religion",
      "collection": "working_papers",
      "author": "James Kennon Rice",
      "category": "working_papers",
      "excerpt": "This essay examines the relationship between critical theological theories within avant-garde scholarship on religion as a social phenomenon and the equally, if not more, pressing revelations of climate scientists regarding the ecological crisis which is partly the result of a society whose faith has been misplaced in a form of unsustainable technology which threatens to destroy us.",
      "date": "2024-11-01",
      "venue": "Science & Religion Forum 2024 Conference",
      "citation": "Rice, James Kennon. (2024). &quot;An Ecological Ethics for the Anthropocene: Environmental Justice and Religion.&quot; <i>SRF Conference Paper 2024</i>."
    },
    "body_sha256": "386bd9f7c0d582968be1a93c1e71f86ebae90fd3db645f14d6ce98a84705b549"
  },
  {
    "source": "_working_papers/liberal_complexity.md",
    "url": "/working_papers/liberal_complexity/",
    "meta": {
      "title": "Climate Change and Complexity in Classical Liberal Theories of Development",
      "collection": "publications",
      "author": "James Kennon Rice",
      "category": "working_papers",
      "excerpt": "In this essay, I develop a complexity-based theory of social interaction within legal constraints, highlighting how rule-of-law institutions enable cooperation even in the face of intricate political and economic pressures based on inequities in mitigating and preparing for climate change..",
      "date": "2025-02-01",
      "venue": "Working Paper",
      "citation": "Rice, James Kennon. (2025). &quot;Climate Change and Complexity in Classical Liberal Theories of Development.&quot; <i>Work in Progress</i>."
    },
    "body_sha256": "ecf7174b09999c35e2cd28dee9a74648c944029b3aefd69e814dc8496ed48079"
  },
